# ============================================================
# Wimmer — Environment Configuration Example
# Copy to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+psycopg2://wimmer:wimmer@localhost:5432/wimmer

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000

# LLM Provider
# Options: mock | nebius | openai
# Use "mock" for development — no API key needed
LLM_PROVIDER=mock

# Nebius AI (optional — for production AI recommendations)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External data integrations (optional)
TAVILY_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
